filters:
  and:
    - 'file.ext == "md"'
    - 'type'
    - 'type != "index"'
    - '!file.inFolder("templates")'
views:
  - type: table
    name: All notes
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - status
      - file.mtime
  - type: table
    name: Open tasks
    filters:
      and:
        - 'type == "task"'
        - 'status != "done"'
    order:
      - file.name
      - status
      - risk
