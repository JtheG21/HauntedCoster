# The one place that names the active game. check.sh, typecheck.sh, stamp.sh, studio-preflight.sh, the pre-commit hook,
# scripts/lune/specs.luau and the guard hook read it. tests/test_active_game.py keeps .vscode in step.
# Plain KEY=value only (no quotes or expansion): shell sources it and Lune parses it. It holds no secrets.
ACTIVE_GAME_ID=GAME-004
ACTIVE_GAME_NAME=MathShow
ACTIVE_GAME_SLUG=mathshow
ACTIVE_GAME_ROOT=games/mathshow
ACTIVE_GAME_PROJECT=mathshow.project.json
ACTIVE_GAME_PLACE=MathShow.rbxl
