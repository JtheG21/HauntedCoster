--!strict
-- MathShow MENU copy. Every user-facing string in the menu flow lives here (put at shared/MenuCopy.luau).
-- ALL CAPS comes from the strings themselves; never use TextTransform. No letter-spacing anywhere.
-- Placeholders: {n} {best} {time} {you} {them} are filled by the Rules functions in RULES_SPEC.md.

local function deepFreeze<T>(t: T): T
	if type(t) == "table" and not table.isfrozen(t :: any) then
		for _, v in t :: any do
			deepFreeze(v)
		end
		table.freeze(t :: any)
	end
	return t
end

