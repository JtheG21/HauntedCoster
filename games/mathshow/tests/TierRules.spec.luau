--!strict
local TestRunner = require(script.Parent.TestRunner)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TierRules = require(ReplicatedStorage.Shared.TierRules)
local TierConfig = require(ReplicatedStorage.Shared.TierConfig)

return function(t: TestRunner.T)
	t.test("nine tiers in blueprint order", function()
		t.eq(#TierConfig.Ids, 9)
		t.eq(TierRules.at(1), "plastic")
		t.eq(TierRules.at(3), "copper")
		t.eq(TierRules.at(6), "emerald")
		t.eq(TierRules.at(9), "demon")
		t.eq(TierRules.at(0), nil)
		t.eq(TierRules.at(10), nil)
		t.eq(TierRules.at(1.5), nil)
		t.eq(TierRules.at(0 / 0), nil)
	end)

	t.test("isValid and indexOf reject unknown, wrong-case and non-string ids", function()
		t.eq(TierRules.isValid("gold"), true)
		t.eq(TierRules.isValid("Gold"), false)
		t.eq(TierRules.isValid(""), false)
		t.eq(TierRules.isValid(4), false)
		t.eq(TierRules.isValid(nil), false)
		t.eq(TierRules.indexOf("silver"), 4)
		t.eq(TierRules.indexOf("nope"), nil)
	end)

	t.test("next and prev stop at the ends", function()
		t.eq(TierRules.next("plastic"), "bronze")
		t.eq(TierRules.next("diamond"), "demon")
		t.eq(TierRules.next("demon"), nil)
		t.eq(TierRules.prev("plastic"), nil)
		t.eq(TierRules.prev("demon"), "diamond")
		t.eq(TierRules.next("nope"), nil)
	end)

	t.test("compare orders tiers and is nil for unknown ids", function()
		t.eq(TierRules.compare("bronze", "copper"), -1)
		t.eq(TierRules.compare("emerald", "gold"), 1)
		t.eq(TierRules.compare("silver", "silver"), 0)
		t.eq(TierRules.compare("silver", "x"), nil)
	end)

	t.test("progressDisplay clamps 0..100 for tiers 1-8", function()
		local d = TierRules.progressDisplay("gold", 40)
		t.eq(d.value, 40)
		t.eq(d.max, 100)
		t.eq(d.hasNext, true)
		t.eq(TierRules.progressDisplay("gold", 100).value, 100)
		t.eq(TierRules.progressDisplay("gold", 250).value, 100)
		t.eq(TierRules.progressDisplay("gold", -5).value, 0)
		t.eq(TierRules.progressDisplay("gold", math.huge).value, 100)
	end)

	t.test("progressDisplay never errors on NaN or junk", function()
		t.eq(TierRules.progressDisplay("gold", 0 / 0).value, 0)
		t.eq(TierRules.progressDisplay("gold", "50").value, 0)
		t.eq(TierRules.progressDisplay("gold", nil).value, 0)
		t.eq(TierRules.progressDisplay("gold", -math.huge).value, 0)
	end)

	t.test("demon shows an uncapped standing with no next tier", function()
		local d = TierRules.progressDisplay("demon", 4321)
		t.eq(d.value, 4321)
		t.eq(d.max, nil)
		t.eq(d.hasNext, false)
		t.eq(TierRules.progressDisplay("demon", -1).value, 0)
		t.eq(TierRules.progressDisplay("demon", 0 / 0).value, 0)
		t.eq(TierRules.progressDisplay("demon", math.huge).value, 0)
	end)
end
