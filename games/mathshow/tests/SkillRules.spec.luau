--!strict
local TestRunner = require(script.Parent.TestRunner)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SkillRules = require(ReplicatedStorage.Shared.SkillRules)

local NAN = 0 / 0

return function(t: TestRunner.T)
	t.test("kindFor: ranks 0-4 typed, 5-9 choice, invalid falls back to typed", function()
		for rank = 0, 4 do
			t.eq(SkillRules.kindFor(rank), "integer")
		end
		for rank = 5, 9 do
			t.eq(SkillRules.kindFor(rank), "choice")
		end
		t.eq(SkillRules.kindFor(-1), "integer")
		t.eq(SkillRules.kindFor(NAN), "integer")
		t.eq(SkillRules.kindFor("9" :: any), "integer")
	end)

	t.test("timeLimit", function()
		t.eq(SkillRules.timeLimit("integer"), 20)
		t.eq(SkillRules.timeLimit("choice"), 25)
	end)

	t.test("advance: a correct answer clears the rank and climbs", function()
		local run = SkillRules.advance(SkillRules.newRun(), true)
		t.eq(run.rank, 1)
		t.eq(run.cleared, 0)
		t.eq(run.misses, 0)
		t.eq(run.finished, false)
	end)

	t.test("advance: a miss repeats the rank, two in a row end the run", function()
		local run = SkillRules.advance(SkillRules.newRun(), false)
		t.eq(run.rank, 0)
		t.eq(run.misses, 1)
		t.eq(run.finished, false)
		t.eq(run.cleared, nil)
		run = SkillRules.advance(run, false)
		t.eq(run.finished, true)
		t.eq(run.cleared, nil)
	end)

	t.test("advance: a correct answer between two misses resets the streak", function()
		local run = SkillRules.advance(SkillRules.newRun(), false)
		run = SkillRules.advance(run, true)
		t.eq(run.misses, 0)
		run = SkillRules.advance(run, false)
		t.eq(run.finished, false, "one miss after a success does not end the run")
		t.eq(run.cleared, 0)
	end)

	t.test("advance: clearing rank 9 ends the run with 9 cleared", function()
		local run = { rank = 9, misses = 1, cleared = 8, finished = false }
		local done = SkillRules.advance(run, true)
		t.eq(done.finished, true)
		t.eq(done.cleared, 9)
		t.eq(done.rank, 9)
	end)

	t.test("advance: a finished run stays finished and the input is not mutated", function()
		local run = { rank = 3, misses = 2, cleared = 2, finished = true }
		local after = SkillRules.advance(run, true)
		t.eq(after.finished, true)
		t.eq(after.rank, 3)
		t.eq(run.rank, 3)
		t.truthy((after :: any) ~= run)
	end)

	t.test("finish ends a run without changing the rest", function()
		local run = { rank = 4, misses = 1, cleared = 3, finished = false }
		local done = SkillRules.finish(run)
		t.eq(done.finished, true)
		t.eq(done.rank, 4)
		t.eq(done.cleared, 3)
		t.eq(run.finished, false)
	end)

	t.test("outcome: first test", function()
		local o = SkillRules.outcome(nil, 4)
		t.eq(o.kind, "first")
		t.eq(o.best, 4)
		t.eq(o.lastTest, 4)
	end)

	t.test("outcome: a first test that clears nothing lands on PLASTIC", function()
		local o = SkillRules.outcome(nil, nil)
		t.eq(o.kind, "first")
		t.eq(o.best, 0)
		t.eq(o.lastTest, 0)
	end)

	t.test("outcome: up, held and a worse run never lower the best", function()
		t.eq(SkillRules.outcome(3, 5).kind, "up")
		t.eq(SkillRules.outcome(3, 5).best, 5)
		local held = SkillRules.outcome(5, 2)
		t.eq(held.kind, "held")
		t.eq(held.best, 5)
		t.eq(held.lastTest, 2)
		local none = SkillRules.outcome(5, nil)
		t.eq(none.kind, "held")
		t.eq(none.best, 5)
		t.eq(none.lastTest, 0)
		t.eq(SkillRules.outcome(0, 0).kind, "held", "equal is held")
	end)

	t.test("validAnswer: typed answers are finite integers within +-1e6", function()
		t.eq(SkillRules.validAnswer("integer", 42), 42)
		t.eq(SkillRules.validAnswer("integer", 0), 0)
		t.eq(SkillRules.validAnswer("integer", 1e6), 1e6)
		t.eq(SkillRules.validAnswer("integer", -1e6), -1e6)
		t.eq(SkillRules.validAnswer("integer", 1e6 + 1), nil)
		t.eq(SkillRules.validAnswer("integer", 2.5), nil)
		t.eq(SkillRules.validAnswer("integer", NAN), nil)
		t.eq(SkillRules.validAnswer("integer", math.huge), nil)
		t.eq(SkillRules.validAnswer("integer", "5"), nil)
		t.eq(SkillRules.validAnswer("integer", nil), nil)
	end)

	t.test("validAnswer: choice answers are indices 1..4", function()
		for index = 1, 4 do
			t.eq(SkillRules.validAnswer("choice", index), index)
		end
		t.eq(SkillRules.validAnswer("choice", 0), nil)
		t.eq(SkillRules.validAnswer("choice", 5), nil)
		t.eq(SkillRules.validAnswer("choice", 1.5), nil)
		t.eq(SkillRules.validAnswer("choice", true), nil)
	end)

	t.test("parseAnswerPayload is exact", function()
		local a, v = SkillRules.parseAnswerPayload({ attempt = 3, answer = 12 })
		t.eq(a, 3)
		t.eq(v, 12)
		t.eq(SkillRules.parseAnswerPayload({ attempt = 3 }), nil)
		t.eq(SkillRules.parseAnswerPayload({ attempt = 0, answer = 1 }), nil)
		t.eq(SkillRules.parseAnswerPayload({ attempt = 1.5, answer = 1 }), nil)
		t.eq(SkillRules.parseAnswerPayload({ attempt = 1, answer = "1" }), nil)
		t.eq(SkillRules.parseAnswerPayload({ attempt = 1, answer = 1, rank = 9 }), nil)
		t.eq(SkillRules.parseAnswerPayload("x"), nil)
		t.eq(SkillRules.parseAnswerPayload(nil), nil)
		t.eq(SkillRules.parseAnswerPayload({ attempt = NAN, answer = 1 }), nil)
	end)

	t.test("validStart accepts nothing or an empty table", function()
		t.eq(SkillRules.validStart(nil), true)
		t.eq(SkillRules.validStart({}), true)
		t.eq(SkillRules.validStart({ rank = 9 }), false)
		t.eq(SkillRules.validStart(1), false)
	end)
end
