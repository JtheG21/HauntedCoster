{
  "name": "HauntedCollector",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "games/haunted/src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "games/haunted/src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "games/haunted/src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 0,
        "Brightness": 1,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Future",
        "Ambient": [0.16, 0.16, 0.22],
        "OutdoorAmbient": [0.33, 0.33, 0.45]
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "TestService": {
      "Tests": {
        "$path": "games/haunted/tests"
      }
    }
  }
}
